{
  "name": "counterexample",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adversarial test-case hunter: paste a function, get the smallest input that breaks it.",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/start.js",
    "selftest": "node server/engine/selftest.js",
    "audit": "node server/target/run-audit.js",
    "test:e2e": "node scripts/e2e.mjs",
    "regression-test": "node server/target/write-regression-test.js",
    "verify:regression-test": "node scripts/verify-regression-test.js",
    "benchmark": "node server/engine/benchmark.js",
    "snapshot": "node server/engine/snapshot.js",
    "check:data": "node scripts/check-data.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "acorn": "^8.14.0",
    "acorn-walk": "^8.3.4",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
