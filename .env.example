# Optional. The deterministic core needs no keys at all.
# Setting one adds an independent oracle for functions outside the built-in
# library, plus a written root-cause explanation. The first one found wins.

# Preferred: fastest free tier, generous limits, no card required.
# GEMINI_API_KEY=

# Fallback options -- set at most one.
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

